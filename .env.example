# Copy this file to .env.local and fill the key locally.
# Never commit .env.local.

OPENROUTER_API_KEY=

# Default first-frame provider through OpenRouter.
VSR_IMAGE_PROVIDER=openrouter
VSR_IMAGE_API_MODEL=bytedance-seed/seedream-4.5
VSR_IMAGE_QUALITY=high
VSR_IMAGE_ENDPOINT=https://openrouter.ai/api/v1/images
VSR_OPENROUTER_TIMEOUT_SECONDS=420
H3_OPENROUTER_ASPECT_RATIO=9:16
H3_OPENROUTER_RESOLUTION=2K

# Optional OpenRouter GPT Image 2 route. On 2026-08-09 this account returned
# provider ToS 403 for OpenAI image models, while Seedream worked.
# VSR_IMAGE_API_MODEL=openai/gpt-image-2
# H3_OPENROUTER_RESOLUTION=

# Optional direct OpenAI route for true GPT Image 2.
# Requires an OpenAI API key whose organization can access image generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional defaults for this repo's first-frame runner.
H3_FIRST_FRAME_PROVIDER_SIZE=1024x1536
H3_FIRST_FRAME_FINAL_SIZE=1080x1920
