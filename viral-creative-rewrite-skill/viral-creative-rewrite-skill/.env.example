# Copy this file to .env and fill values locally.
# Do not paste secrets into chat, logs, or shared docs.

# Local MiniMax H3 / ComfyUI generation endpoint.
H3_COMFYUI_SERVER=http://127.0.0.1:8189

# Optional when the skill is installed outside this workflow repo.
H3_WORKFLOW_ROOT=../..

# Optional. Defaults to H3_WORKFLOW_ROOT/sequence_outputs.
H3_OUTPUT_ROOT=

# Optional. Set to 1 to build prompt files and sequence.json without submitting to ComfyUI.
H3_DRY_RUN=0

# Local output for prepared/result JSON and rehearsal artifacts. Keep this outside the skill folder.
OUTPUT_DIR=../output

# Optional. Defaults to OUTPUT_DIR/cache.
VIRAL_REWRITE_CACHE_DIR=

# Optional debug artifacts. Disabled by default.
VIRAL_REWRITE_SHOW_DEBUG_ARTIFACTS=0
